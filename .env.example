# NextAuth / Auth.js Configuration
AUTH_SECRET=your_nextauth_auth_secret_minimum_32_characters
NEXTAUTH_SECRET=your_nextauth_auth_secret_minimum_32_characters
NEXTAUTH_URL=http://localhost:3000

# Google OAuth Provider (from Google Cloud Console: https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# MongoDB Database
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/dbname
MONGODB_URI=your_mongodb_connection_string

# AI Analysis (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key

# Medical document OCR/analysis backend (Node service, returns prediction + LIME/SHAP explanation)
NEXT_PUBLIC_UPLOAD_API_URL=https://major-project-node-deloyment.onrender.com/api/upload-report
